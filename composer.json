{
  "name": "milpa/agent",
  "description": "Long-running coding sessions for the Milpa PHP framework: a session is an event-sourced stream \u2014 conversation, plan, todos, granted permissions and human decision points \u2014 that survives the process, so an agent can be paused, resumed, audited and stopped.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "agent",
    "ai",
    "session",
    "event-sourcing",
    "coding-agent"
  ],
  "type": "milpa-capability",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "milpa/event-store": ">=0.3 <1.0",
    "milpa/command": ">=0.18 <1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/core": ">=0.6.2 <1.0"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Agent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Agent\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  },
  "extra": {
    "milpa": {
      "capability": {
        "id": "agent",
        "title": "Sessions that outlive the process: plan, todos, permissions and decisions",
        "unlocks": [
          "agent:sessions",
          "agent:show",
          "agent:timeline",
          "agent:answer",
          "agent:mode",
          "coa chat"
        ],
        "provides": [
          "agent.sessions"
        ],
        "briefing": "This app stores agent sessions: you can pause, ask for permission, and have someone answer later.",
        "contracts": {
          "agent.sessions": "Milpa\\Agent\\SessionStore"
        }
      }
    }
  }
}
